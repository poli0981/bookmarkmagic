{
  "name": "bookmarkmagic",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "Import, export & edit bookmarks between browsers — offline, no account, no cloud.",
  "license": "GPL-3.0-or-later",
  "author": "skullmute (poli0981)",
  "homepage": "https://github.com/poli0981/bookmarkmagic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/poli0981/bookmarkmagic.git"
  },
  "bugs": {
    "url": "https://github.com/poli0981/bookmarkmagic/issues"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "postinstall": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "zip": "wxt zip",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "knip": "knip",
    "guard": "node scripts/guard.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run check && npm run knip && npm run guard && npm run test",
    "verify:full": "npm run verify && npm run coverage && npm run build && npm run check:manifest"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.5",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@wxt-dev/module-svelte": "^2.0.5",
    "jsdom": "^30.1.3",
    "knip": "^6.42.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "npm:@typescript/typescript6@~6.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.4"
  }
}
