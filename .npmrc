# Supply-chain cooldown (docs/01 §6): resolve every install to the newest
# release that has been public for at least 7 days. Malicious versions
# published to npm have historically been caught and pulled within hours to
# days; a week of age keeps this repo out of that window. Units are DAYS.
# Dependabot applies the same rule through `cooldown` in dependabot.yml.
min-release-age=7
